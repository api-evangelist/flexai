{
  "opencollection": "1.0.0",
  "info": {
    "name": "FlexAI Token Factory Audio Completions API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Completions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a text completion (legacy)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://tokens.flex.ai/v1/completions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Legacy text-completion endpoint kept for OpenAI compatibility. Prefer /chat/completions for new work."
        }
      ]
    }
  ],
  "bundled": true
}